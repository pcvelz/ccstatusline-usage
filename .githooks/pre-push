#!/bin/sh
# Pre-push gate: run the EXACT same checks as the CI pipeline (lint+types,
# tests, build) on whatever is about to be pushed. Enabled via:
#   git config core.hooksPath .githooks
#
# WHY THIS EXISTS IN ADDITION TO pre-commit: pre-commit only fires on `git
# commit`. Merge commits built via plumbing (git commit-tree + update-ref, used
# when a pathspec-less commit is blocked) skip it entirely - that is exactly how
# f524d22 reached CI with type errors (run 31795712456). Push is the last local
# boundary before the pipeline, so the full CI criteria are enforced here,
# regardless of how the commits were created.
#
# The checks run against the CURRENT WORKING TREE of this checkout, which for
# any normal push equals the pushed HEAD. Pushing refs that do not match the
# working tree (e.g. pushing another branch by name) still gets a best-effort
# gate rather than none.
#
# Upstream merges: every upstream-merge commit in the pushed range must also
# pass scripts/verify-upstream-merge.sh (fork customizations, no version bump,
# no unexplained hand edits, test inventory). The release flow commits and
# pushes in one step, so this is where the merge gate is enforced even when
# the merging agent skipped it. A merge counts as an upstream merge when its
# second parent is in upstream/main; clones without an `upstream` remote skip it.

ZERO=0000000000000000000000000000000000000000
MERGE_STATUS=0

if git rev-parse -q --verify upstream/main >/dev/null 2>&1; then
    while read -r LOCAL_REF LOCAL_OID REMOTE_REF REMOTE_OID; do
        [ "$LOCAL_OID" = "$ZERO" ] && continue
        if [ "$REMOTE_OID" = "$ZERO" ]; then
            MERGES=$(git rev-list --merges "$LOCAL_OID" --not --remotes=origin 2>/dev/null)
        else
            MERGES=$(git rev-list --merges "$REMOTE_OID..$LOCAL_OID" 2>/dev/null)
        fi
        for MERGE in $MERGES; do
            SECOND=$(git rev-parse -q --verify "$MERGE^2") || continue
            git merge-base --is-ancestor "$SECOND" upstream/main || continue
            echo "[pre-push] upstream merge $(git log -1 --format='%h %s' "$MERGE") - running verify-upstream-merge.sh"
            if ! bash scripts/verify-upstream-merge.sh "$MERGE"; then
                echo "[pre-push] BLOCKED: $MERGE fails the upstream-merge gate. Fix, amend the merge commit, push again." >&2
                MERGE_STATUS=1
            fi
        done
    done
fi
[ "$MERGE_STATUS" -eq 0 ] || exit 1

echo "[pre-push] running CI criteria: bun run lint (tsc + eslint)..."
if ! bun run lint; then
    echo "[pre-push] BLOCKED: lint/type check failed - the pipeline would fail identically." >&2
    exit 1
fi

sh scripts/wait-for-quiet-load.sh pre-push || exit 1

echo "[pre-push] running bun test..."
if ! bun test; then
    echo "[pre-push] BLOCKED: tests failed - the pipeline would fail identically." >&2
    exit 1
fi

echo "[pre-push] running bun run build..."
if ! bun run build || [ ! -f dist/ccstatusline.js ]; then
    echo "[pre-push] BLOCKED: build failed - the pipeline would fail identically." >&2
    exit 1
fi

echo "[pre-push] all CI criteria green - pushing."
exit 0
